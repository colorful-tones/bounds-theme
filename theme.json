						"right": "0",
						"top": "0"
					}
				}
			},
			"core/group": {
				"css": "&.vl{position:relative;z-index:1;}\n&.vl:before {border-left: 2px dashed currentColor;content:' ';display:block;height: 100%;opacity:0.45;position: absolute;left: calc(50% - 1px);top: 0;width: 2px;z-index:-1;}"
			},
